# AFSAR Backend Environment Configuration
AFSAR_HOST=127.0.0.1
AFSAR_PORT=8000
AFSAR_OLLAMA_URL=http://127.0.0.1:11434
AFSAR_MODEL_NAME=llama3.2:3b
AFSAR_MODEL_KEEP_ALIVE=30m
AFSAR_TTS_VOICE=en-US-AriaNeural
AFSAR_TTS_RATE=-8%
AFSAR_TTS_PITCH=-4Hz
AFSAR_LOG_LEVEL=INFO
AFSAR_DATA_DIR=../data
AFSAR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:1420,tauri://localhost,https://tauri.localhost
AFSAR_REQUEST_TIMEOUT=60.0
AFSAR_ENV=development
